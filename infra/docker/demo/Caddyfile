# The demo stack's proxy (infra/docker/compose.demo.yml). The only thing a visitor reaches.
{
	# No admin endpoint: the configuration is this file, read at start.
	admin off
	# Only TCP is published (compose.demo.yml): HTTP/3 would be offered to browsers and never
	# answer.
	servers {
		protocols h1 h2
	}
}

{$DEMO_HOST} {
	# Empty for a public certificate; "tls internal" in the smoke.
	{$DEMO_TLS}

	# The gate: a user name and the hash of its password, set by `scripts/demo_stack.sh init`.
	# Everything below is behind it — the sign-in of the demo has no password of its own.
	# The block is written out here, and not imported from a generated file: with nothing to
	# fill it, it refuses every visitor — an import that found an empty file would be no gate.
	basic_auth {
		{$DEMO_GATE_USER} {$DEMO_GATE_HASH}
	}

	encode zstd gzip

	# X-Forwarded-For: Caddy writes the address it saw and drops what a client sent (it has
	# no trusted proxies of its own configured). The API counts its per-address limits on it.
	reverse_proxy web:3000 {
		# The gate's credentials stop here; the application never sees them.
		header_up -Authorization
	}
}
